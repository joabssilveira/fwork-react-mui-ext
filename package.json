  "types": "dist/types/index.d.ts",
  "name": "fwork-react-mui-ext",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "scripts": {
    "dev:example": "webpack serve --config appExample/webpack.config.js",
